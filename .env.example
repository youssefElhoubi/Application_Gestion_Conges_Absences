# PostgreSQL Database Configuration
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase
POSTGRES_PORT=5432

# Database Connection URL (for local host development connecting to Docker PostgreSQL)
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydatabase?schema=public"

# Application Server Configuration
PORT=3000
PRISMA_STUDIO_PORT=5555
NODE_ENV=development

# Authentication & Security
# Required: 32+ character secret for JWT access token signing (HS256).
# Generate a cryptographically secure key:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-min-32-chars-long!
COOKIE_SECURE=false

# Seeding & Initial Credentials (development / testing only)
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_EMPLOYEE_PASSWORD=EmployeePassword123!
