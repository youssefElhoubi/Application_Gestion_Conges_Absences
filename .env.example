# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Application: Leave & Absence Management System (Next.js 16 + Prisma 7 + PostgreSQL)
# Deployment Target: Vercel (Frontend & Serverless Functions)
# Database Provider: Neon PostgreSQL (Serverless) / Local Docker PostgreSQL
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY RULES:
#   1. NEVER commit '.env' or any live credentials/secrets to version control.
#   2. NEVER place secrets in NEXT_PUBLIC_ variables (exposed in browser JavaScript).
#   3. NEVER replace local Docker settings with hardcoded Neon production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL & Prisma ORM 7)
# ------------------------------------------------------------------------------

# DATABASE_URL:
#   Required at: Application runtime and build-time.
#   Purpose: Primary connection string used by the application runtime and Prisma Client.
#   
#   Local Host Dev (Next.js on host connecting to Docker PostgreSQL container):
#     postgresql://myuser:mypassword@localhost:5432/mydatabase?schema=public
#
#   Containerized Dev (Next.js inside Docker Compose network):
#     postgresql://myuser:mypassword@db:5432/mydatabase?schema=public
#
#   Vercel Production with Neon PostgreSQL (POOLED Connection String):
#     CRITICAL FOR VERCEL: Must point to the POOLED connection string (includes '-pooler').
#     Serverless functions on Vercel scale horizontally; connection pooling via Neon's
#     PgBouncer pooler is essential to prevent exhausting database connection limits.
#     Format:
#       postgresql://<USER>:<PASSWORD>@<HOST>-pooler.<REGION>.aws.neon.tech/<DBNAME>?sslmode=require
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydatabase?schema=public"

# DIRECT_URL:
#   Required at: Database migration operations (Prisma CLI).
#   Purpose: Unpooled, direct compute connection string used exclusively by Prisma Migrate.
#   
#   Vercel / CI Migration with Neon PostgreSQL (DIRECT Connection String):
#     CRITICAL FOR MIGRATIONS: Neon's PgBouncer pooler (DATABASE_URL) runs in transaction
#     pooling mode, which does NOT support session-level advisory locks (pg_advisory_lock).
#     Prisma Migrate requires advisory locks to prevent concurrent migration collisions.
#     DIRECT_URL connects directly to the Neon compute endpoint (bypassing -pooler).
#     prisma.config.ts automatically uses DIRECT_URL for migrations when defined.
#     Format:
#       postgresql://<USER>:<PASSWORD>@<HOST>.<REGION>.aws.neon.tech/<DBNAME>?sslmode=require
#
#   Local Development:
#     Leave commented out or set identical to DATABASE_URL.
# DIRECT_URL="postgresql://myuser:mypassword@localhost:5432/mydatabase?schema=public"

# PostgreSQL Container Credentials (used by Docker Compose 'db' service for local dev):
#   Required for: Docker Compose interpolation when spinning up the local PostgreSQL container.
#   DO NOT REPLACE WITH NEON CREDENTIALS - these are strictly for local docker-compose.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. APPLICATION SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# NODE_ENV:
#   Required at: Build-time and runtime.
#   Options: 'development' | 'production' | 'test'
#   Impact: Controls React optimizations, error masking, and cookie security flags.
#   Note: Vercel sets this automatically to 'production' in production deployments.
NODE_ENV=development

# PORT:
#   Optional (Runtime). Default: 3000.
#   Network port where the Next.js HTTP server listens.
PORT=3000

# HOSTNAME:
#   Optional (Runtime). Default: '0.0.0.0' in Docker, 'localhost' on host.
HOSTNAME=0.0.0.0

# PRISMA_STUDIO_PORT:
#   Optional (Development only). Default: 5555.
#   Port for the local Prisma Studio database GUI runner.
PRISMA_STUDIO_PORT=5555

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# JWT_ACCESS_SECRET:
#   Required at: Runtime.
#   Purpose: Cryptographic secret key used to sign and verify HS256 JWT access tokens.
#   Security Constraint: In production (NODE_ENV=production), MUST be at least 32 characters.
#   Generate a cryptographically secure key:
#     openssl rand -base64 32
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-min-32-chars-long!

# COOKIE_SECURE:
#   Optional (Runtime). Default: false in development, automatically true in production.
#   Controls whether auth cookies (access_token, refresh_token) set the 'Secure' attribute.
#   On Vercel (HTTPS), this is enforced as true by application code when NODE_ENV=production.
COOKIE_SECURE=false

# TRUSTED_PROXY:
#   Required at: Runtime when deployed behind a reverse proxy or load balancer.
#   Options: 'true' | 'false' (Default: 'false').
#   Purpose: When 'true', allows RateLimiterService to read 'X-Forwarded-For' and 'X-Real-IP'.
#   CRITICAL ON VERCEL: In production on Vercel, this MUST be set to 'true'.
#   Vercel routes requests through Edge reverse proxies. If 'false', all client IPs default
#   to '127.0.0.1', causing all users globally to share one rate-limit bucket and triggering
#   an application-wide lockout after a few failed login attempts.
TRUSTED_PROXY=false

# AUTH_SESSION_IDLE_TIMEOUT_SECONDS:
#   Optional (Runtime). Default: 86400 (24 hours).
#   Maximum inactivity duration before a user session requires re-authentication.
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=86400

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION RATE LIMITING (PostgreSQL RateLimitLedger)
# ------------------------------------------------------------------------------
# AUTH_RATE_LIMIT_MAX_ATTEMPTS:
#   Optional (Runtime). Default: 10.
#   Maximum allowed failed attempts per rolling window before hard throttling.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# AUTH_RATE_LIMIT_WINDOW_SECONDS:
#   Optional (Runtime). Default: 300 (5 minutes).
#   Rolling window duration in seconds for tracking failed login/refresh attempts.
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# AUTH_RATE_LIMIT_BASE_DELAY_MS:
#   Optional (Runtime). Default: 1000 (1 second).
#   Base multiplier for exponential progressive delay backoff (attempts 3+).
AUTH_RATE_LIMIT_BASE_DELAY_MS=1000

# AUTH_RATE_LIMIT_MAX_DELAY_MS:
#   Optional (Runtime). Default: 10000 (10 seconds).
#   Maximum ceiling for progressive backoff delay.
AUTH_RATE_LIMIT_MAX_DELAY_MS=10000

# ------------------------------------------------------------------------------
# 5. INITIAL DATABASE SEEDING CREDENTIALS (Development / Staging Only)
# ------------------------------------------------------------------------------
# SEED_ADMIN_PASSWORD:
#   Optional (Development / Initial Setup only). Default: 'AdminPassword123!'.
#   Initial password for the default administrator account (usr-admin-default / admin@entreprise.ma).
#   DANGER: Never run database seeding in a live production environment with live data.
SEED_ADMIN_PASSWORD=AdminPassword123!

# SEED_EMPLOYEE_PASSWORD:
#   Optional (Development / Initial Setup only). Default: 'EmployeePassword123!'.
#   Initial password for sample employee accounts (e.g. fz.alami@entreprise.ma).
SEED_EMPLOYEE_PASSWORD=EmployeePassword123!
