# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Application: Leave & Absence Management System (Next.js 16 + Prisma 7 + PostgreSQL)
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# NOTE: Never commit '.env' or real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL & Prisma ORM)
# ------------------------------------------------------------------------------
# DATABASE_URL:
#   Required at: Runtime and build-time (Prisma CLI migration and client validation).
#   Purpose: Full PostgreSQL connection string used by Prisma ORM and application runtime.
#   Local Host Dev (Next.js on host connecting to Docker PostgreSQL):
#     postgresql://myuser:mypassword@localhost:5432/mydatabase?schema=public
#   Containerized Dev / Production (Next.js inside Docker Compose network):
#     postgresql://myuser:mypassword@db:5432/mydatabase?schema=public
#   Managed External Database (AWS RDS / Neon / Supabase):
#     postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>?sslmode=require
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydatabase?schema=public"

# PostgreSQL Container Credentials (used by Docker Compose 'db' service):
#   Required for: Docker Compose interpolation when spinning up the local PostgreSQL container.
#   Production: Replace with strong, unique credentials or use a managed database service.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. APPLICATION SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# NODE_ENV:
#   Required at: Build-time and runtime.
#   Options: 'development' | 'production' | 'test'
#   Impact: Affects React optimization, error detail masking, and cookie security flags.
NODE_ENV=development

# PORT:
#   Optional (Runtime). Default: 3000.
#   Port where Next.js listens for incoming HTTP requests.
PORT=3000

# HOSTNAME:
#   Optional (Runtime). Default: '0.0.0.0' in Docker, 'localhost' on host.
#   Network interface to bind the Next.js server to.
HOSTNAME=0.0.0.0

# PRISMA_STUDIO_PORT:
#   Optional (Development only). Default: 5555.
#   Port for the local Prisma Studio database GUI runner.
PRISMA_STUDIO_PORT=5555

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# JWT_ACCESS_SECRET:
#   Required at: Runtime.
#   Purpose: Cryptographic secret key used to sign and verify HS256 JWT access tokens.
#   Security Constraint: In production (NODE_ENV=production), MUST be at least 32 characters.
#   Docker Compose: Required by the 'web' service; Compose configuration fails if omitted.
#   Generate a cryptographically secure key:
#     openssl rand -base64 32
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-min-32-chars-long!

# COOKIE_SECURE:
#   Optional (Runtime). Default: false in development, automatically true in production.
#   Controls whether auth cookies (access_token, refresh_token) set the 'Secure' attribute.
#   Note: If NODE_ENV=production, Secure is enforced by application code.
COOKIE_SECURE=false

# TRUSTED_PROXY:
#   Required at: Runtime when deployed behind a reverse proxy or load balancer.
#   Options: 'true' | 'false' (Default: 'false').
#   Purpose: When 'true', allows RateLimiterService to read 'X-Forwarded-For' and 'X-Real-IP'.
#   WARNING: In production behind Nginx/Caddy/Cloudflare/AWS ALB, this MUST be set to 'true'.
#            If 'false' behind a proxy, all client IPs default to '127.0.0.1', causing
#            shared rate-limit exhaustion and application-wide lockout.
TRUSTED_PROXY=false

# AUTH_SESSION_IDLE_TIMEOUT_SECONDS:
#   Optional (Runtime). Default: 86400 (24 hours).
#   Maximum inactivity duration before a user session requires re-authentication.
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=86400

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION RATE LIMITING (PostgreSQL RateLimitLedger)
# ------------------------------------------------------------------------------
# AUTH_RATE_LIMIT_MAX_ATTEMPTS:
#   Optional (Runtime). Default: 10.
#   Maximum allowed failed attempts per rolling window before hard throttling.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# AUTH_RATE_LIMIT_WINDOW_SECONDS:
#   Optional (Runtime). Default: 300 (5 minutes).
#   Rolling window duration in seconds for tracking failed login/refresh attempts.
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# AUTH_RATE_LIMIT_BASE_DELAY_MS:
#   Optional (Runtime). Default: 1000 (1 second).
#   Base multiplier for exponential progressive delay backoff (attempts 3+).
AUTH_RATE_LIMIT_BASE_DELAY_MS=1000

# AUTH_RATE_LIMIT_MAX_DELAY_MS:
#   Optional (Runtime). Default: 10000 (10 seconds).
#   Maximum cap for progressive delay.
AUTH_RATE_LIMIT_MAX_DELAY_MS=10000

# ------------------------------------------------------------------------------
# 5. INITIAL DATABASE SEEDING CREDENTIALS (Development / Staging Only)
# ------------------------------------------------------------------------------
# SEED_ADMIN_PASSWORD:
#   Optional (Development only). Default: 'AdminPassword123!'.
#   Initial password for the default administrator account (usr-admin-default / MAT-0042).
#   DANGER: Never run database seeding in a live production environment.
SEED_ADMIN_PASSWORD=AdminPassword123!

# SEED_EMPLOYEE_PASSWORD:
#   Optional (Development only). Default: 'EmployeePassword123!'.
#   Initial password for sample employee accounts (e.g. usr-emp-alami).
SEED_EMPLOYEE_PASSWORD=EmployeePassword123!
